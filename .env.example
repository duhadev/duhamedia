# Duha Media — environment variables. NAMES ONLY: never commit values.
# Copy to `.env` for local dev. Cloud values live in the Vercel project's
# Environment Variables (Production / Preview / Development scopes). Everything
# is read at runtime; there are no NEXT_PUBLIC_* variables.
# Never pull Vercel env into `.env.local` / `.env.production*` (Next and the
# Payload CLI auto-load those); use a non-auto-loaded file and source it.

# --- Database ---------------------------------------------------------------
# Local dev: docker-compose Postgres, e.g. postgresql://user:pass@localhost:5432/dbname
DATABASE_URI=
# Optional direct (non-pooled) string, used by `pnpm migrate:deploy` and `pnpm seed`
# (PAYLOAD_DB_DIRECT=true). Unset = DATABASE_URI.
DATABASE_URI_UNPOOLED=
# Vercel: set by the Neon integration (pooled / direct). These WIN over
# DATABASE_URI* when present (src/lib/databaseUrl.ts). Do not set locally.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Long random string; signs Payload auth tokens. Unique per environment.
PAYLOAD_SECRET=
# production | staging | development — drives noindex, event `env`, /_showcase
# (Vercel: Production = production, Preview = staging)
APP_ENV=
# Canonical origin, no trailing slash, e.g. https://duhamedia.com. Required on
# Production. Optional on Vercel Preview (falls back to VERCEL_BRANCH_URL / VERCEL_URL).
SITE_URL=

# --- Uploads ----------------------------------------------------------------
# Vercel Blob read/write token (set by Vercel when a Blob store is connected).
# Set = media + downloads go to Blob. Unset = local disk under MEDIA_DIR.
BLOB_READ_WRITE_TOKEN=
# LOCAL DEV ONLY: absolute path of the local upload directory. Defaults to
# ./media under the working directory. Ignored when BLOB_READ_WRITE_TOKEN is set.
MEDIA_DIR=

# --- Jobs -------------------------------------------------------------------
# Vercel Cron bearer for GET /api/payload-jobs/run (>= 16 random chars).
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`. Not needed locally
# (in-process autoRun).
CRON_SECRET=

# --- OpenClaw secretary -----------------------------------------------------
# Site-event receiver URL (public https hostname on the secretary's Cloudflare
# tunnel, from the server agent; a local stub URL in dev)
SITE_EVENT_URL=
# HMAC-SHA256 key for X-Duha-Signature
SITE_EVENT_SECRET=
# Cloudflare Access service token for SITE_EVENT_URL (sent as CF-Access-Client-Id /
# CF-Access-Client-Secret). Both or neither; unset = no Access headers.
SITE_EVENT_ACCESS_CLIENT_ID=
SITE_EVENT_ACCESS_CLIENT_SECRET=
# Development only (ignored unless APP_ENV=development): five comma-separated
# retry delays in seconds, e.g. 5,5,5,5,5, to compress the delivery retry schedule.
SITE_EVENT_RETRY_DELAYS_S=
# Development only (ignored unless APP_ENV=development): seconds, shortens the
# 10-minute site_error rate-limit window for local proofs.
SITE_ERROR_WINDOW_S=

# Resend full-access key (transport + Contacts). Unset = emails are logged to console.
RESEND_API_KEY=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_NEWSLETTER_TOPIC_ID=
# Optional: inbox for form notification emails when a form's "Email to" is empty
# (form-builder `defaultToEmail`). Unset = falls back to the from-address.
FORMS_DEFAULT_TO_EMAIL=

# Cloudflare Turnstile. Site key is read at runtime and passed to the widget as a
# prop. Dev: Cloudflare's public test keys (DECISIONS.md §L); unset in development
# falls back to them. Staging/production: required, and a test secret fails closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
