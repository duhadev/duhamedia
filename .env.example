# Duha Media — environment variables. NAMES ONLY: never commit values.
# Copy to `.env` for local dev. Server values live in the server agent's
# owner-only .env files. Everything is read at runtime; there are no
# NEXT_PUBLIC_* variables (one image serves staging and production).

# Postgres connection string, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URI=
# Long random string; signs Payload auth tokens. Unique per environment.
PAYLOAD_SECRET=
# production | staging | development — drives noindex, event `env`, /_showcase
APP_ENV=
# Canonical origin, no trailing slash, e.g. https://duhamedia.com
SITE_URL=
# Absolute path of the media directory (bind mount in the container).
# Defaults to ./media under the working directory when unset.
MEDIA_DIR=

# OpenClaw secretary site-event receiver (internal address, from the server agent)
SITE_EVENT_URL=
# HMAC-SHA256 key for X-Duha-Signature
SITE_EVENT_SECRET=
# Development only (ignored unless APP_ENV=development): five comma-separated
# retry delays in seconds, e.g. 5,5,5,5,5, to compress the delivery retry schedule.
SITE_EVENT_RETRY_DELAYS_S=

# Resend full-access key (transport + Contacts). Unset = emails are logged to console.
RESEND_API_KEY=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_NEWSLETTER_TOPIC_ID=
# Optional: inbox for form notification emails when a form's "Email to" is empty
# (form-builder `defaultToEmail`). Unset = falls back to the from-address.
FORMS_DEFAULT_TO_EMAIL=

# Cloudflare Turnstile. Site key is read at runtime and passed to the widget as a
# prop. Dev: Cloudflare's public test keys (DECISIONS.md §L); unset in development
# falls back to them. Staging/production: required, and a test secret fails closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
